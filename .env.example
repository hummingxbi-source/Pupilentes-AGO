# Variables del FRONTEND. Copia este archivo como .env.local (nunca se sube al repo).
# Solo las que empiezan con VITE_ llegan al navegador: aquí NO va ningún secreto.
# Los secretos del backend van en supabase/functions/.env (ver supabase/functions/.env.example)
# y, en la nube, en los secrets de Supabase. ARQUITECTURA §2.3 y §4.

# --- Supabase ---
# Local: `supabase start` (o `supabase status`) imprime la URL y la llave publicable.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Cloudflare Turnstile ---
# Llave de PRUEBA de Cloudflare que siempre aprueba (solo desarrollo):
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- Chatbot (fuera de alcance; ARQUITECTURA §1) ---
# Solo se incluye en el build con "true". El código vive en la rama `demo`.
VITE_CHATBOT=false
