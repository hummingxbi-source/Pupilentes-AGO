# Copia este archivo como .env.local (desarrollo) y pon los mismos valores en Vercel → Settings → Environment Variables.
# Ninguna de estas claves va en el código ni en el navegador, salvo las que empiezan con VITE_.

# --- IA (obligatoria para respuestas con IA; sin ella el chat funciona en "modo básico") ---
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5

# --- Firma de sesiones (cualquier texto largo y aleatorio: openssl rand -hex 32) ---
CHAT_SECRET=

# --- Contadores compartidos (Upstash Redis, plan gratis). Obligatorio en producción ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Anti-bots: Cloudflare Turnstile (gratis) ---
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Solo aceptar peticiones desde el dominio de la tienda (separados por coma) ---
CHAT_ALLOWED_ORIGINS=https://pupilentes-ago.vercel.app

# --- Límites (valores por defecto entre paréntesis) ---
CHAT_MAX_MSGS=6               # preguntas a la IA por sesión (6)
CHAT_IP_PER_MIN=8             # mensajes por minuto por IP (8)
CHAT_IP_PER_DAY=40            # mensajes por día por IP (40)
CHAT_SESSIONS_PER_IP_DAY=6    # sesiones nuevas por día por IP (6)
CHAT_DAILY_CAP=1500           # llamadas a la IA por día en toda la tienda (1500)

# --- Consulta de uso: GET /api/chat?clave=... ---
CHAT_ADMIN_KEY=
