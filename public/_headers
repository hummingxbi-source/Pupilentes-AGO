# Cabeceras de seguridad para Cloudflare Pages (ARQUITECTURA §6.1 regla 10).
# Fase 0: CSP en modo SOLO-REPORTE (avisa en la consola del navegador, no bloquea).
# Fase 3: pasa a Content-Security-Policy estricta, sumando Mercado Pago, el dominio
# de Supabase del proyecto y el dominio de imágenes de R2.
#   - wasm-unsafe-eval: lo necesita MediaPipe (probador con cámara).
#   - challenges.cloudflare.com: Turnstile (script e iframe).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Archivos con hash: caché larga e inmutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
