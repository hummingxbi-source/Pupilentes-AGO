{
  "name": "pupilentes-ago",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "supabase test db",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "semilla": "node scripts/generar-semilla.mjs",
    "importar": "node scripts/importar-catalogo.mjs",
    "test:concurrencia": "node tests/integracion/stock-concurrencia.mjs",
    "test:simultaneo": "node --test --test-concurrency=1 tests/integracion/simultaneo.mjs",
    "test:maraton": "node --test --test-concurrency=1 tests/integracion/maraton.mjs",
    "test:e2e": "playwright test",
    "test:e2e:humo": "playwright test tests/e2e/pantallas/humo.spec.mjs --project=escritorio-chromium",
    "test:e2e:flujos": "playwright test tests/e2e/flujos --project=escritorio-chromium",
    "test:e2e:ui": "playwright test --ui",
    "e2e:navegadores": "playwright install chromium firefox webkit",
    "e2e:reporte": "playwright show-report"
  },
  "dependencies": {
    "@gsap/react": "^2.1.1",
    "@mediapipe/tasks-vision": "^0.10.14",
    "@supabase/supabase-js": "2.119.0",
    "canvas-confetti": "^1.9.4",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.1",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.70.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.1",
    "@vitejs/plugin-react": "^6.3.0",
    "aws4fetch": "^1.0.20",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
