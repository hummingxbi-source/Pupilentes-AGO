# Secrets de las Edge Functions en LOCAL. Copia a supabase/functions/.env (no se sube al repo).
# En la nube se cargan con: supabase secrets set --env-file <archivo>
# SUPABASE_URL y las llaves SUPABASE_*_KEYS las pone la plataforma; no van aquí.

# Orígenes que pueden llamar a las funciones desde el navegador (coma)
ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173

# Secreto que manda Supabase Cron; igual al secreto `secreto_cron` de Vault (local: seed.sql). Mín. 16 caracteres.
CRON_SECRET=cron-local-solo-desarrollo

# Turnstile: llave de PRUEBA de Cloudflare que siempre aprueba (solo desarrollo).
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
