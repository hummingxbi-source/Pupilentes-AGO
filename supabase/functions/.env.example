# Secrets de las Edge Functions en LOCAL. Copia a supabase/functions/.env (no se sube al repo).
# En la nube se cargan con: supabase secrets set --env-file <archivo>
# SUPABASE_URL y las llaves SUPABASE_*_KEYS las pone la plataforma; no van aquí.

# Orígenes que pueden llamar a las funciones desde el navegador (coma)
ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173

# Secreto que manda Supabase Cron; igual al secreto `secreto_cron` de Vault (local: seed.sql). Mín. 16 caracteres.
CRON_SECRET=cron-local-solo-desarrollo

# Turnstile: llave de PRUEBA de Cloudflare que siempre aprueba (solo desarrollo).
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# URL pública de la tienda (regreso de Mercado Pago y enlace de rastreo). Local: Vite.
SITIO_URL=http://localhost:5173

# Mercado Pago (Fase 3). Credenciales de PRUEBA de "Tus integraciones" → tu app → Credenciales de prueba.
# El access token NUNCA va en el navegador. MP_WEBHOOK_SECRET = "Clave secreta" de Webhooks en la app.
# MP_NOTIFICATION_URL debe ser https pública (en local: el simulador `node scripts/mp-simulado.mjs`, ver docs/ARQUITECTURA.md).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=
# Solo para pruebas locales con un Mercado Pago simulado; en la nube se deja vacío.
MP_API_URL=

# Bucket PRIVADO de comprobantes de transferencia (R2, pospuesto). Sin esto, la tienda ofrece WhatsApp.
R2_COMPROBANTES_ACCESS_KEY_ID=
R2_COMPROBANTES_SECRET_ACCESS_KEY=
R2_COMPROBANTES_BUCKET=

# Correo de alertas al equipo (Resend). Opcional: sin esto las alertas solo se ven en el panel.
RESEND_API_KEY=
ALERTAS_CORREO=
ALERTAS_REMITENTE=
